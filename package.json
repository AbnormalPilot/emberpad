{
  "name": "emberpad",
  "version": "1.0.0",
  "description": "A tiny Express notes app that uses coalburn for restarts and live reload",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "coalburn --port 3000 server.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "coalburn": "^1.0.2"
  }
}
